#!/usr/bin/python3
"""Unprivileged Touch Bar client; no shell execution or session access."""

import argparse
import json
import socket
import struct
import sys


def request(action, uid=1000, address=None):
    if action not in ("screenshot", "settings"):
        raise ValueError("Invalid action")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(30)
        try:
            connection.connect(address or "\0dfr-capture-" + str(uid))
        except OSError as error:
            raise OSError("Desktop receiver unavailable. As graphical UID 1000, complete the user-session setup and check systemctl --user status touchbar-capture.service. For Settings use the application menu or /usr/local/bin/dfr-configurator; see /usr/share/doc/tiny-dfr/INSTALL.md") from error
        _, peer_uid, _ = struct.unpack("3i", connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        if peer_uid != uid:
            raise ValueError("Unexpected desktop receiver UID")
        connection.sendall(action.encode("ascii"))
        connection.shutdown(socket.SHUT_WR)
        response = bytearray()
        while len(response) < 4096:
            chunk = connection.recv(4096 - len(response))
            if not chunk:
                break
            response.extend(chunk)
        result = json.loads(response)
        if not isinstance(result, dict) or result.get("ok") is not True:
            raise ValueError(result.get("error", "Capture receiver rejected request") if isinstance(result, dict) else "Invalid receiver response")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("screenshot", "settings"))
    args = parser.parse_args()
    try:
        request(args.action)
    except (OSError, ValueError) as error:
        print(f"Capture handoff failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
