[Unit]
Description=Touch Bar desktop-session display brightness
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/dfr-brightness
Environment=PATH=/usr/bin:/bin
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
